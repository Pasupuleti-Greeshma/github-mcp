{
  "name": "github-mcp",
  "version": "1.0.0",
  "description": "MCP server for GitHub (Repositories, Pull Requests, Issues, Actions, User details)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "github",
    "pull-requests",
    "repos"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "dotenv": "^17.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
